{
  "expo": {
    "name": "Word Connect Multilingual",
    "slug": "word-connect-multilingual",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0F3A26"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wordconnect.multilingual"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F3A26"
      },
      "package": "com.wordconnect.multilingual"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    }
  }
}
